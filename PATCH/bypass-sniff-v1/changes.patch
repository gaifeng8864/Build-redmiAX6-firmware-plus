+-- User-managed Xray sniffing settings v2
+if local_port ~= "0" then
+    local rules = assert(
+        loadfile("/usr/share/bypass/sniff_rules.lua")
+    )()
+
+    local global = ucursor:get_all("bypass", "@global[0]") or {}
+
+    local function read_rules(path)
+        local f, err = io.open(path, "rb")
+
+        if not f then
+            if err and err:find("No such file", 1, true) then
+                return {}
+            end
+            error("Cannot open " .. path .. ": " .. tostring(err))
+        end
+
+        local content = f:read("*a")
+        f:close()
+        assert(content, "Cannot read " .. path)
+
+        local normalized, values = rules.normalize(content)
+        assert(normalized, path .. ": " .. tostring(values))
+
+        return values
+    end
+
+    local inbound
+    for _, item in ipairs(Xray.inbounds) do
+        if item.protocol == "dokodemo-door"
+            and item.port == tonumber(local_port) then
+            inbound = item
+            break
+        end
+    end
+
+    assert(inbound and inbound.sniffing,
+        "Xray sniffing inbound not found")
+
+    local sniff = inbound.sniffing
+
+    sniff.enabled = global.sniffing_enabled ~= "0"
+    sniff.routeOnly = global.sniffing_route_only == "1"
+
+    sniff.domainsExcluded = rules.merge(
+        sniff.domainsExcluded or {},
+        read_rules("/etc/bypass/custom_sniff_domains.list")
+    )
+
+    local ips = rules.merge(
+        sniff.ipsExcluded or {},
+        read_rules("/etc/bypass/custom_sniff_ips.list")
+    )
+
+    if #ips > 0 then
+        sniff.ipsExcluded = ips
+    end
+end
