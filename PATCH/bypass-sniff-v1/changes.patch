 -- [[ fragmen Settings ]]--
 if is_finded("xray") then
+-- Xray Sniffing Settings v3
+local fs = require "nixio.fs"
+local rules = assert(loadfile(
+    "/usr/share/bypass/sniff_rules.lua"
+))()
+
+local sniff_paths = {
+    "/etc/bypass/custom_sniff_domains.list",
+    "/etc/bypass/custom_sniff_ips.list"
+}
+
+local sniff_pending = {}
+
+local function read_sniff_file(path)
+    local kind = fs.lstat(path, "type")
+
+    if not kind then return "" end
+
+    assert(kind == "reg",
+        "Invalid rules file type: " .. path)
+
+    return assert(fs.readfile(path),
+        "Cannot read rules file: " .. path)
+end
+
+local sniff_section = m:section(
+    TypedSection, "global",
+    translate("Xray Sniffing Settings")
+)
+sniff_section.anonymous = true
+
+local item = sniff_section:option(
+    Flag, "sniffing_enabled",
+    translate("Enable Sniffing")
+)
+item.default = "1"
+item.rmempty = false
+
+item = sniff_section:option(
+    Flag, "sniffing_route_only",
+    translate("Sniffing Route Only"),
+    translate("Keep original destination address.")
+)
+item.default = "0"
+item.rmempty = false
+
+local function add_sniff_editor(index, option, title)
+    local path = sniff_paths[index]
+
+    local editor = sniff_section:option(
+        TextValue, option, translate(title),
+        translate("One entry per line.")
+    )
+
+    editor.rows = 5
+    editor.wrap = "off"
+    editor.rmempty = true
+
+    editor.cfgvalue = function(self, section)
+        return read_sniff_file(path)
+    end
+
+    editor.validate = function(self, value, section)
+        local normalized, err = rules.normalize(value or "")
+
+        if not normalized then
+            return nil, tostring(err)
+        end
+
+        return normalized
+    end
+
+    editor.write = function(self, section, value)
+        sniff_pending[index] = value
+        return true
+    end
+
+    editor.remove = function(self, section)
+        if self:formvalue(section) == nil then
+            return false
+        end
+        if read_sniff_file(path) ~= "" then
+            sniff_pending[index] = ""
+            return true
+        end
+        return false
+    end
+end
+
+add_sniff_editor(1, "_sniff_domains",
+    "Custom Sniffing Excluded Domains")
+
+add_sniff_editor(2, "_sniff_ips",
+    "Custom Sniffing Excluded IPs")
+
+item = sniff_section:option(
+    DummyValue, "_sniff_builtin",
+    translate("Built-in Exclusions")
+)
+item.cfgvalue = function(self, section)
+    return "Built-in exclusions are preserved."
+end
+
+function m.on_before_save(self)
+    if sniff_pending[1] == nil
+        and sniff_pending[2] == nil then
+        return
+    end
+
+    local texts = {}
+
+    for i = 1, 2 do
+        texts[i] = sniff_pending[i]
+
+        if texts[i] == nil then
+            texts[i] = read_sniff_file(sniff_paths[i])
+        end
+    end
+
+    local ok, err = rules.save_pair(sniff_paths, texts)
+
+    assert(ok, "Failed to save sniffing rules: "
+        .. tostring(err))
+end
 s = m:section(TypedSection, "global_xray_fragment", translate("Xray Fragment Settings"))
 s.anonymous = true
 
